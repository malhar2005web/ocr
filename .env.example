# ========================================================
# UNIVERSAL DOCUMENT INTELLIGENCE AND EXTRACTION PLATFORM
# Environment Configuration
# ========================================================

# Application Settings
ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# PostgreSQL Database Configuration
# Update with your local or cloud PostgreSQL credentials:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=doc_intelligence

# Storage Settings
# Upload directory for storing documents
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50

# OCR Engine (Tesseract)
# If tesseract is not in your system PATH, provide the absolute path:
# Windows Example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux Example: /usr/bin/tesseract
TESSERACT_CMD=tesseract

# LLM Provider Configuration (Open-Weight Models: Qwen, Llama 3)
# Works with any OpenAI-compatible hosted inference provider (OpenRouter, Groq, Together AI, Ollama, vLLM)
# If left empty, the system automatically runs in high-accuracy OCR-only heuristic mode!
LLM_PROVIDER=open_weight
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=qwen-2.5-72b-instruct
LLM_TIMEOUT=90

# Optional RAG Module
ENABLE_RAG=True

# Optional Security / API Key Authentication
API_KEY_AUTH_ENABLED=False
API_KEY=your_secret_api_key_here
